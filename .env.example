DISCORD_TOKEN=
OPEN_NOTEBOOK_URL=http://localhost:5055
# Only needed when Open Notebook password protection is enabled.
OPEN_NOTEBOOK_PASSWORD=
# Leave empty to use Open Notebook's default chat model (must be Ollama).
# Use the registered model: ID, not the Ollama model name.
OPEN_NOTEBOOK_MODEL_ID=
OPEN_NOTEBOOK_CHAT_TIMEOUT=180
# Host-published HTTP port, not the Docker-internal ws://surrealdb:8000/rpc URL.
SURREAL_URL=http://localhost:8001
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook
SURREAL_USER=root
SURREAL_PASSWORD=
